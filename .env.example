# Copy to .env and fill in real values:  cp .env.example .env
#
# In CI/CD these come from GitHub Environment secrets/variables, not this file.

# --- Directus image / ports ---------------------------------------------------
# Local dev uses these. On a fresh VPS/instance the deploy compose serves the
# frontend on port 80 by default (set WEB_PORT only if 80 is already taken on the
# host, as on a box already running another web server / reverse proxy).
DIRECTUS_VERSION=11
DIRECTUS_PORT=8055          # host port for Directus (public-facing, incl. /admin)
WEB_PORT=8080              # frontend port for local dev (deploy default is 80)

# --- Directus secrets ---------------------------------------------------------
# Signs access tokens. MUST stay stable across restarts or sessions break.
# Generate: openssl rand -hex 32
DIRECTUS_SECRET=change-me-to-a-random-32-byte-hex

# Initial admin, created on first boot of an empty database. Set a real password.
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me

# Public URL of Directus, used for admin deep-links and PUBLIC_URL.
# Local:   http://localhost:8055
# Deployed example: http://your-host:8055  (or a Cloudflare hostname)
DIRECTUS_PUBLIC_URL=http://localhost:8055

# --- Deploy only (ignored locally) -------------------------------------------
# Prebuilt web image to run on the host. Local builds ignore this.
# WEB_IMAGE=ghcr.io/synap5e/directus-node-starter/web:staging

# --- Cloudflare Tunnel (optional, see docs/cloudflare.md) --------------------
# Only used with docker-compose.cloudflared.yml. From the Zero Trust dashboard.
# CLOUDFLARE_TUNNEL_TOKEN=
